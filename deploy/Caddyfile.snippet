# ── TIVE 360° — Root-Domain (Marketing-Landing + universeller Login) ──
# Ersetzt den bisherigen redir-Block:
#   tive360.de, www.tive360.de { redir https://hr.tive360.de{uri} permanent }
#
# Liefert stattdessen die statischen Root-Files aus /var/www/tive360/root.
# Auf der VM in die Caddyfile übernehmen und `caddy reload` (bzw.
# `systemctl reload caddy`) ausführen.

tive360.de, www.tive360.de {
    root * /var/www/tive360/root
    encode gzip

    # /login  bzw.  /login.html  → login.html ; sonst index.html
    try_files {path} {path}.html /index.html
    file_server
}

# Hinweis: Die Subdomains bleiben unverändert und zeigen weiter auf ihre
# jeweiligen Verzeichnisse:
#   hr.tive360.de           → /var/www/tive360/hr
#   mitarbeiter.tive360.de  → /var/www/tive360/mitarbeiter
#   client.tive360.de       → /var/www/tive360/client
